# Supabase 프로젝트 설정 (https://app.supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# 클라이언트/공개용 키 (publishable 또는 anon)
SUPABASE_KEY=your-publishable-or-anon-key
# 서버 전용 비밀 키 (RLS 우회). 절대 프론트엔드에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# JWT 서명 비밀키 (충분히 길고 임의의 문자열로 변경하세요)
JWT_SECRET=change-this-to-a-long-random-secret
# 선택: 토큰 만료 (미설정 시 기본 7d)
# JWT_EXPIRES_IN=7d

# 서버 포트
PORT=5000

# 실행 환경 (development | production)
NODE_ENV=development

# CORS 허용 프론트엔드 주소
FRONTEND_URL=http://localhost:3000
